#include <windows.h>
#include "resource.h"

IDI_MAIN ICON "icon.ico"
IDR_MANIFEST RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FanControl-Hotkey Project"
            VALUE "FileDescription",  "FanControl Hotkey & Process Auto Switcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "FanControlHotkey"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "FanControlHotkey.exe"
            VALUE "ProductName",      "FanControl Hotkey"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
